{
  "info": {
    "_postman_id": "eventsphere-concurrency-api-suite",
    "name": "EventSphere – Multi-Tenant Event & Ticket Reservation System",
    "description": "Production-ready Postman collection with automated test assertions for EventSphere multi-tenant reservation engine, mock payment gateway, RBAC authorization, and concurrency validation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "organizerToken", "value": "", "type": "string" },
    { "key": "attendeeToken", "value": "", "type": "string" },
    { "key": "eventId", "value": "evt-1", "type": "string" },
    { "key": "tierId", "value": "tier-evt1-vip", "type": "string" },
    { "key": "reservationId", "value": "", "type": "string" },
    { "key": "paymentId", "value": "", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData).to.have.property('token');",
                  "pm.collectionVariables.set('adminToken', jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@eventsphere.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login as Organizer (Pulse Events)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('organizerToken', jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sarah@pulseevents.com\",\n  \"password\": \"Organizer@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login as Attendee",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('attendeeToken', jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"attendee@example.com\",\n  \"password\": \"Attendee@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "2. Public Events Discovery",
      "item": [
        {
          "name": "Get Published Events (Redis Cached)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.events).to.be.an('array');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] }
          }
        },
        {
          "name": "Get Event Details by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.event).to.have.property('ticketTiers');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["events", "{{eventId}}"] }
          }
        }
      ]
    },
    {
      "name": "3. Concurrency-Safe 10-Min Reservation Hold",
      "item": [
        {
          "name": "Create Reservation Hold (10-minute hold)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.reservation.status).to.eql('PENDING');",
                  "pm.expect(json.reservation.remainingSeconds).to.be.above(550);",
                  "pm.collectionVariables.set('reservationId', json.reservation.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{attendeeToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"items\": [\n    {\n      \"ticketTierId\": \"{{tierId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"idempotencyKey\": \"postman-idemp-001\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/reservations", "host": ["{{baseUrl}}"], "path": ["reservations"] }
          }
        },
        {
          "name": "Get Reservation by ID (Live Countdown Check)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.reservation.remainingSeconds).to.be.a('number');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{attendeeToken}}" }],
            "url": { "raw": "{{baseUrl}}/reservations/{{reservationId}}", "host": ["{{baseUrl}}"], "path": ["reservations", "{{reservationId}}"] }
          }
        }
      ]
    },
    {
      "name": "4. Mock Payment Gateway & Checkout",
      "item": [
        {
          "name": "Initiate Payment Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.paymentIntent.status).to.eql('INITIATED');",
                  "pm.collectionVariables.set('paymentId', json.paymentIntent.paymentId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{attendeeToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservationId\": \"{{reservationId}}\",\n  \"simulationMode\": \"SUCCESS\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments/initiate", "host": ["{{baseUrl}}"], "path": ["payments", "initiate"] }
          }
        },
        {
          "name": "Process Payment (Simulation: SUCCESS)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.payment.status).to.eql('SUCCESS');",
                  "pm.expect(json.order).to.have.property('bookingReference');",
                  "pm.collectionVariables.set('orderId', json.order.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{attendeeToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"{{paymentId}}\",\n  \"mode\": \"SUCCESS\",\n  \"attendeeName\": \"Alex Johnson\",\n  \"attendeeEmail\": \"attendee@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments/process", "host": ["{{baseUrl}}"], "path": ["payments", "process"] }
          }
        }
      ]
    },
    {
      "name": "5. Organizer Analytics & Tenant Isolation",
      "item": [
        {
          "name": "Get Organizer Analytics Overview",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.kpi).to.have.property('conversionRate');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{organizerToken}}" }],
            "url": { "raw": "{{baseUrl}}/organizer/analytics/overview", "host": ["{{baseUrl}}"], "path": ["organizer", "analytics", "overview"] }
          }
        }
      ]
    },
    {
      "name": "6. High-Contention Concurrency Test",
      "item": [
        {
          "name": "Trigger 20-Concurrent Reservation Test (10 Tickets Total)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.result.passed).to.be.true;",
                  "pm.expect(json.result.successCount).to.eql(10);",
                  "pm.expect(json.result.failureCount).to.eql(10);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/tests/concurrency", "host": ["{{baseUrl}}"], "path": ["tests", "concurrency"] }
          }
        }
      ]
    }
  ]
}
