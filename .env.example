# Server & Environment
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Security & Authentication
JWT_SECRET="eventsphere-jwt-secret-production-grade-key-2026"
JWT_EXPIRES_IN="7d"

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventsphere?schema=public"

# Redis Cache & BullMQ Queue
REDIS_URL="redis://localhost:6379"

# Ticket Hold & Reservation Configuration
RESERVATION_HOLD_MINUTES=10
CLEANUP_INTERVAL_SECONDS=5

# Payment Simulation
PAYMENT_SIMULATION_DELAY_MS=1200

# Optional Gemini AI API for event descriptions and summaries
GEMINI_API_KEY="MY_GEMINI_API_KEY"

